# Copie para ~/.jarvis-os/.env (NUNCA para dentro do repositório).
# O jarvisd lê as chaves pelo nome indicado em "apiKeyEnv" no config.json.

# 9Router (local, compatível com OpenAI)
NINEROUTER_API_KEY=

# Ollama local normalmente não exige chave
OLLAMA_API_KEY=

# Nível de log: trace | debug | info | warn | error
JARVIS_LOG_LEVEL=info
