{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS-OS",
  "version": "0.1.0",
  "identifier": "com.mchiodi.jarvis-os",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS-OS",
        "label": "overlay",
        "url": "/",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'self' http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:;",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "MCHIODI",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-common"]
      }
    }
  },
  "plugins": {
    "global-hotkey": {
      "default": "Super+Alt+J"
    },
    "store": {},
    "log": {
      "level": "info",
      "targets": ["log", "webview"]
    },
    "shell": {
      "open": true,
      "scope": {
        "allow": ["git *", "claude *", "npx *", "bun *", "pnpm *"]
      }
    },
    "fs": {
      "scope": {
        "allow": ["$APPDATA/jarvis-os/**", "$HOME/.jarvis-os/**", "$PROJECT/**"]
      }
    },
    "dialog": {
      "open": true,
      "save": true
    },
    "http": {
      "scope": ["http://localhost:*", "https://api.anthropic.com/*", "https://api.openai.com/*"]
    }
  }
}