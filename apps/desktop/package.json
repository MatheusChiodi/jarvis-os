{
  "name": "@jarvis-os/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri desktop app with floating button and overlay",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "dev": "tauri dev",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "devDependencies": {
    "@jarvis-os/core": "workspace:*",
    "@jarvis-os/memory": "workspace:*",
    "@jarvis-os/runtime": "workspace:*",
    "@jarvis-os/skills": "workspace:*",
    "@jarvis-os/voice": "workspace:*",
    "@jarvis-os/video": "workspace:*",
    "@jarvis-os/pixel": "workspace:*",
    "@jarvis-os/ui-kit": "workspace:*",
    "@jarvis-os/tsconfig": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.48.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0",
    "immer": "^10.1.0",
    "tailwind-merge": "^2.5.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.450.0",
    "zod": "^3.23.8",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  }
}