{
  "name": "@jarvis-os/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Agent runtime with Superpowers workflow, git worktrees, TDD enforcement, and code review",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./teams": {
      "types": "./dist/teams/index.d.ts",
      "import": "./dist/teams/index.js",
      "default": "./dist/teams/index.js"
    },
    "./planner": {
      "types": "./dist/planner/index.d.ts",
      "import": "./dist/planner/index.js",
      "default": "./dist/planner/index.js"
    },
    "./executor": {
      "types": "./dist/executor/index.d.ts",
      "import": "./dist/executor/index.js",
      "default": "./dist/executor/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js",
      "default": "./dist/git/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@jarvis-os/core": "workspace:*",
    "@jarvis-os/memory": "workspace:*",
    "@jarvis-os/skills": "workspace:*",
    "@jarvis-os/tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  }
}