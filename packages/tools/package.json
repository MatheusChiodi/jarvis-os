{
  "name": "@jarvis-os/tools",
  "version": "0.1.0",
  "private": true,
  "description": "Agent tools with risk classification and sandbox",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@jarvis-os/core": "workspace:*",
    "@jarvis-os/memory": "workspace:*",
    "@jarvis-os/protocol": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "pino": "^9.2.0"
  }
}